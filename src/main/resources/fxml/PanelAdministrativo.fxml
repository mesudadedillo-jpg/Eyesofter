<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<BorderPane stylesheets="@../css/estilos.css" styleClass="app-root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eyesofter.ui.ControladorPanelAdministrativo">
    <left><VBox prefWidth="230" styleClass="sidebar"><children>
        <VBox spacing="4" styleClass="marca-panel"><children><Label text="◉  EYESOFTER" styleClass="marca-panel-titulo"/><Label text="TAMIZAJE VISUAL LOCAL" styleClass="marca-panel-subtitulo"/></children><padding><Insets top="28" right="22" bottom="22" left="22"/></padding></VBox>
        <VBox spacing="5" VBox.vgrow="ALWAYS" styleClass="menu-panel"><children>
            <Button fx:id="btnInicio" text="▦   Inicio" onAction="#inicio" styleClass="boton-menu"/>
            <Button fx:id="btnPacientes" text="♙   Pacientes" onAction="#pacientes" styleClass="boton-menu"/>
            <Button fx:id="btnHistorial" text="◉   Evaluaciones" onAction="#historial" styleClass="boton-menu"/>
            <Button fx:id="btnReportes" text="▥   Reportes" onAction="#reportes" styleClass="boton-menu"/>
            <Button fx:id="btnConfiguracion" text="⚙   Configuración" onAction="#configuracion" styleClass="boton-menu"/>
        </children><padding><Insets top="18" right="12" bottom="18" left="12"/></padding></VBox>
        <Button text="⏻   Cerrar sesión" onAction="#cerrarSesion" styleClass="boton-salir"><VBox.margin><Insets top="8" right="12" bottom="8" left="12"/></VBox.margin></Button>
        <Button text="■   Salir de la aplicación" onAction="#salirAplicacion" styleClass="boton-salir"><VBox.margin><Insets top="0" right="12" bottom="22" left="12"/></VBox.margin></Button>
    </children></VBox></left>
    <top><HBox alignment="CENTER_LEFT" spacing="16" styleClass="barra-panel"><children><VBox><Label text="Panel de control" styleClass="titulo-barra-panel"/><Label text="Datos clínicos almacenados localmente" styleClass="subtitulo-barra-panel"/></VBox><Region HBox.hgrow="ALWAYS"/><Label text="EO" styleClass="avatar-panel"/><Label text="Operador local" styleClass="usuario-panel"/></children><padding><Insets top="14" right="30" bottom="14" left="30"/></padding></HBox></top>
    <center><StackPane fx:id="contenido"/></center>
</BorderPane>
