<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<!-- El StackPane actúa como fondo a pantalla completa y carga el CSS -->
<StackPane stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eyesofter.ui.ControladorConfiguracion">
    <children>
      <!-- Con desplazamiento: en pantallas bajas los textos de ayuda ya no se cortan con "…" -->
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-transparente">
        <content>
        <StackPane>
        <padding><Insets top="20.0" bottom="20.0" /></padding>
        <children>
        <!-- Tarjeta Central Mágica -->
        <VBox alignment="CENTER" spacing="14.0" styleClass="contenedor-principal" maxWidth="800" maxHeight="-Infinity">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="8"><Button text="← Regresar" onAction="#volver" styleClass="boton-secundario"/><Button text="Salir" onAction="#salirAplicacion" styleClass="boton-salir"/></HBox>

                <!-- Título -->
                <Label text="Configuración del entorno" styleClass="etiqueta-titulo" style="-fx-font-size: 38px;" />

                <!-- Datos del Paciente (Se actualizará desde Java) -->
                <Label fx:id="lblAlumno" text="Paciente: [Nombre]" style="-fx-text-fill: #164E59; -fx-font-size: 22px; -fx-font-weight: 700;" />

                <Separator />

                <!-- Configuración de Distancia (Slider) -->
                <Label text="Distancia de evaluación (metros)" styleClass="etiqueta-instruccion" style="-fx-font-size: 22px; -fx-text-fill: #073B4C;" />
                <Slider fx:id="sliderDistancia" max="4.0" min="0.5" value="1.0" majorTickUnit="0.5" minorTickCount="0" showTickLabels="true" showTickMarks="true" snapToTicks="true" maxWidth="500"/>
                <Label fx:id="lblValorDistancia" text="Distancia seleccionada: 1.0 metros" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #118AB2;" />

                <Separator />

                <!-- Configuración de Pantalla (PPI) -->
                <Label text="Densidad de pantalla (PPI)" styleClass="etiqueta-instruccion" style="-fx-font-size: 22px; -fx-text-fill: #073B4C;" />
                <HBox alignment="CENTER" spacing="10">
                    <TextField fx:id="txtPPI" promptText="Ej. 96, 120" styleClass="campo-texto" maxWidth="160" alignment="CENTER">
                        <tooltip>
                            <Tooltip text="Calculado desde la diagonal. Para máxima exactitud use “Medir con tarjeta”." />
                        </tooltip>
                    </TextField>
                    <Button text="📐 Medir con tarjeta" onAction="#medirConTarjeta" styleClass="boton-acento"/>
                </HBox>
                <Label fx:id="lblResolucion" text="Detectando resolución de pantalla…" styleClass="etiqueta-subtitulo" wrapText="true" textAlignment="CENTER" maxWidth="640" minHeight="-Infinity" />

                <Separator />

                <!-- Qué alcanza a medir esta pantalla a esta distancia -->
                <Label fx:id="lblLimite" text="" minHeight="-Infinity" styleClass="etiqueta-subtitulo" wrapText="true" textAlignment="CENTER" maxWidth="640" />

                <Separator />

                <!-- Datos del paciente que ajustan la prueba (solo con paciente) -->
                <VBox fx:id="panelPaciente" alignment="CENTER" spacing="12">
                    <children>
                        <Label text="Tipo de optotipo" styleClass="etiqueta-instruccion" style="-fx-font-size: 20px; -fx-text-fill: #073B4C;" />
                        <ComboBox fx:id="cmbOptotipo" maxWidth="520" />
                        <Label fx:id="lblSugerenciaOptotipo" text="" minHeight="-Infinity" styleClass="etiqueta-subtitulo" wrapText="true" textAlignment="CENTER" maxWidth="600" />
                        <HBox alignment="CENTER" spacing="10">
                            <Label text="Distancia entre pupilas (DP, mm, opcional):" styleClass="etiqueta-subtitulo" />
                            <TextField fx:id="txtDp" promptText="Ej. 58" styleClass="campo-texto" maxWidth="110" alignment="CENTER">
                                <tooltip>
                                    <Tooltip text="Si la clínica la midió con regla o pupilómetro. Sin este dato se estima por la edad." />
                                </tooltip>
                            </TextField>
                        </HBox>
                        <Label fx:id="lblDpEstimada" text="" minHeight="-Infinity" styleClass="etiqueta-subtitulo" wrapText="true" textAlignment="CENTER" maxWidth="600" />
                        <CheckBox fx:id="chkBrillo" text="Brillo de la pantalla al máximo, sin reflejos ni luz de frente al paciente" wrapText="true" maxWidth="600" />
                    </children>
                </VBox>

                <Label fx:id="lblEstadoCamara" text="" minHeight="-Infinity" styleClass="etiqueta-subtitulo" wrapText="true" textAlignment="CENTER" maxWidth="600" />

                <Separator />

                <!-- Botón de Acción -->
                <!-- Asignamos onAction para que ejecute directamente el método en Java -->
                <Button fx:id="btnIniciarBienvenida" text="Guardar y verificar periféricos" styleClass="boton-primario" onAction="#guardarYContinuar" />

            </children>
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
            </padding>
        </VBox>
        </children>
        </StackPane>
        </content>
      </ScrollPane>
    </children>
</StackPane>
