<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ScrollPane?>
<ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="pagina-scroll" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eyesofter.ui.ControladorConfiguracionAdministrativo"><content><VBox spacing="16" styleClass="pagina-admin"><padding><Insets top="26" right="32" bottom="30" left="32"/></padding><children>
    <VBox spacing="3"><Label text="Configuración" styleClass="titulo-admin"/><Label text="Gestiona las credenciales y parámetros del equipo local." styleClass="subtitulo-admin"/></VBox>
    <VBox spacing="13" styleClass="tarjeta-admin"><Label text="Cuenta" styleClass="subtitulo-seccion"/><Label text="Gestiona las credenciales de acceso del encargado activo." styleClass="etiqueta-subtitulo"/><Separator/><HBox alignment="CENTER_LEFT"><VBox HBox.hgrow="ALWAYS"><Label text="Nombre de usuario" styleClass="etiqueta-kpi"/><Label fx:id="lblUsuario" text="root" styleClass="etiqueta-instruccion"/></VBox><Button text="Crear nueva cuenta" onAction="#crearCuenta" styleClass="boton-primario"/><Button text="Cambiar usuario" onAction="#cambiarUsuario" styleClass="boton-secundario"/></HBox><HBox alignment="CENTER_LEFT" spacing="8"><VBox HBox.hgrow="ALWAYS"><Label text="Contraseña" styleClass="etiqueta-kpi"/><Label text="Cámbiala o verifica que sea la actual" styleClass="etiqueta-subtitulo"/></VBox><Button text="Verificar" onAction="#verContrasena" styleClass="boton-secundario"/><Button text="Cambiar" onAction="#cambiarContrasena" styleClass="boton-secundario"/></HBox><HBox alignment="CENTER_LEFT" spacing="8"><VBox HBox.hgrow="ALWAYS"><Label text="Recuperación" styleClass="etiqueta-kpi"/><Label text="Pregunta y respuesta para restablecer la contraseña" styleClass="etiqueta-subtitulo"/></VBox><Button text="Configurar pregunta" onAction="#configurarVerificacion" styleClass="boton-secundario"/></HBox></VBox>
    <VBox spacing="13" styleClass="tarjeta-admin"><Label text="Configuraciones Operativas" styleClass="subtitulo-seccion"/><Label text="Parámetros de hardware y periféricos utilizados durante las evaluaciones." styleClass="etiqueta-subtitulo"/><Separator/><HBox alignment="CENTER_LEFT"><VBox HBox.hgrow="ALWAYS"><Label text="Micrófono" styleClass="etiqueta-kpi"/><Label text="Dispositivo de entrada de voz" styleClass="etiqueta-subtitulo"/></VBox><ComboBox fx:id="cmbMicrofono" prefWidth="260"/></HBox><HBox alignment="CENTER_LEFT"><VBox HBox.hgrow="ALWAYS"><Label text="Distancia de evaluación predeterminada" styleClass="etiqueta-kpi"/><Label text="Distancia inicial para carta de Snellen" styleClass="etiqueta-subtitulo"/></VBox><ComboBox fx:id="cmbDistancia" prefWidth="260"/></HBox><HBox alignment="CENTER_LEFT"><VBox HBox.hgrow="ALWAYS"><Label text="Cámara" styleClass="etiqueta-kpi"/><Label text="Dispositivo de captura fotográfica" styleClass="etiqueta-subtitulo"/></VBox><ComboBox fx:id="cmbCamara" prefWidth="260"/></HBox><HBox alignment="CENTER_RIGHT" spacing="10"><Label fx:id="lblEntorno" text="Cargando…" styleClass="etiqueta-subtitulo" HBox.hgrow="ALWAYS"/><Button text="Configuración avanzada" onAction="#abrirEntorno" styleClass="boton-secundario"/><Button text="Guardar ajustes" onAction="#guardarOperativa" styleClass="boton-primario"/></HBox><Label fx:id="lblGuardado" styleClass="etiqueta-subtitulo"/></VBox>
    <VBox spacing="10" styleClass="tarjeta-admin"><Label text="Estilos" styleClass="subtitulo-seccion"/><Label text="Personaliza la apariencia visual de toda la interfaz." styleClass="etiqueta-subtitulo"/><Separator/><HBox alignment="CENTER_LEFT"><VBox HBox.hgrow="ALWAYS"><Label text="Modo oscuro" styleClass="etiqueta-kpi"/><Label text="Se conserva al cambiar de pantalla y al reiniciar." styleClass="etiqueta-subtitulo"/></VBox><ToggleButton fx:id="tgTema" text="Modo oscuro" onAction="#alternarTema"/></HBox></VBox>
</children></VBox></content></ScrollPane>
