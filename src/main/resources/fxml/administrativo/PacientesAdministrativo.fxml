<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<VBox spacing="18" styleClass="pagina-admin" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eyesofter.ui.ControladorPacientesAdministrativo"><padding><Insets top="28" right="32" bottom="32" left="32"/></padding><children>
    <HBox alignment="CENTER_LEFT"><VBox spacing="4"><Label text="Gestión de pacientes" styleClass="titulo-admin"/><Label text="Directorio de estudiantes y responsables registrados." styleClass="subtitulo-admin"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="+ Nuevo paciente" onAction="#nuevoPaciente" styleClass="boton-primario"/></HBox>
    <HBox spacing="10"><TextField fx:id="txtBuscar" promptText="Buscar en todos los campos…" styleClass="campo-texto" HBox.hgrow="ALWAYS"/><Button text="Limpiar filtros" onAction="#limpiarFiltro" styleClass="boton-secundario"/><Button text="Ver ficha" onAction="#verFicha" styleClass="boton-secundario"/></HBox>
    <HBox spacing="8"><TextField fx:id="txtFiltroCurp" promptText="CURP" styleClass="campo-texto" HBox.hgrow="ALWAYS"/><TextField fx:id="txtFiltroNombre" promptText="Paciente" styleClass="campo-texto" HBox.hgrow="ALWAYS"/><TextField fx:id="txtFiltroGrupo" promptText="Grado / grupo" styleClass="campo-texto" HBox.hgrow="ALWAYS"/><TextField fx:id="txtFiltroTutor" promptText="Tutor" styleClass="campo-texto" HBox.hgrow="ALWAYS"/><TextField fx:id="txtFiltroTelefono" promptText="Teléfono" styleClass="campo-texto" HBox.hgrow="ALWAYS"/><TextField fx:id="txtFiltroCorreo" promptText="Correo" styleClass="campo-texto" HBox.hgrow="ALWAYS"/></HBox>
    <VBox spacing="12" styleClass="tarjeta-admin" VBox.vgrow="ALWAYS"><Label text="Pacientes registrados" styleClass="subtitulo-seccion"/><TableView fx:id="tablaPacientes" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="colNombre" text="PACIENTE" prefWidth="190"/><TableColumn fx:id="colTelefono" text="TELÉFONO" prefWidth="125"/><TableColumn fx:id="colCorreo" text="CORREO" prefWidth="185"/><TableColumn fx:id="colTutor" text="NOMBRE DEL TUTOR" prefWidth="165"/><TableColumn fx:id="colEstado" text="ESTADO ACTUAL" prefWidth="125"/><TableColumn fx:id="colCurp" text="CURP" prefWidth="145"/><TableColumn fx:id="colGrado" text="GRADO / GRUPO" prefWidth="140"/></columns></TableView></VBox>
</children></VBox>
