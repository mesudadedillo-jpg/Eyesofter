<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<StackPane stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eyesofter.ui.ControladorExpedientes">
 <children><VBox maxWidth="1250" spacing="18" styleClass="pagina-clinica"><children>
   <HBox alignment="CENTER_LEFT"><children><VBox HBox.hgrow="ALWAYS" spacing="5"><children><Label text="Expedientes de tamizaje" styleClass="etiqueta-titulo" /><Label text="Resultados almacenados localmente; son apoyo de tamizaje y no sustituyen diagnóstico." styleClass="etiqueta-subtitulo" /></children></VBox><Button text="Volver" onAction="#volver" styleClass="boton-primario" /></children></HBox>
   <TableView fx:id="tablaExpedientes" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="colPaciente" text="Paciente" prefWidth="190" /><TableColumn fx:id="colFecha" text="Fecha y hora" prefWidth="165" /><TableColumn fx:id="colAgudeza" text="Agudeza visual" prefWidth="210" /><TableColumn fx:id="colCromatico" text="Tamizaje cromático" prefWidth="210" /><TableColumn fx:id="colRecomendacion" text="Orientación" prefWidth="420" /></columns></TableView>
 </children><padding><Insets top="34" right="42" bottom="42" left="42" /></padding></VBox></children>
</StackPane>
